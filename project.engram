  "decisions": [
    {
      "id": "ADR-0001",
      "title": "Rust core with a C ABI, SwiftUI shell",
      "status": "active",
      "context": "The memory engine must be shared by a native macOS app and a headless MCP server, deterministic, and fast to start.",
      "decision": "Implement the engine once in Rust, expose it to Swift through a cbindgen-generated C ABI, and compile engram-mcp from the same crate.",
      "rejected_alternatives": [
        {
          "option": "Electron",
          "reason": "heavy runtime, non-native windowing and shortcuts"
        },
        {
          "option": "Pure Swift engine",
          "reason": "the MCP server would need a second implementation"
        },
        {
          "option": "UniFFI",
          "reason": "extra codegen layer for a small JSON-shaped API"
        }
      ],
      "related": [
        "engram-core",
        "ffi-bridge"
      ],
      "created_at": "2026-11-23T08:15:17Z",
      "updated_at": "2026-11-23T08:15:17Z"
    },
    {
      "id": "ADR-0002",
      "title": "JSON with line-array Markdown as the file format",
      "status": "active",
      "context": "Project memory must be human-readable, diffable in Git and trivially parseable by agents and tools.",
      "decision": "Store pretty-printed JSON; multi-line Markdown becomes an array of lines.",
      "rejected_alternatives": [
        {
          "option": "SQLite",
          "reason": "binary, unreviewable diffs"
        },
        {
          "option": "YAML",
          "reason": "ambiguous typing and indentation-sensitive merges"
        },
        {
          "option": "TOML",
          "reason": "awkward for deeply nested arrays of tables"
        }
      ],
      "related": [
        "git-friendly-format",
        "engram-file"
      ],
      "created_at": "2026-11-23T08:15:17Z",
      "updated_at": "2026-11-23T08:15:17Z"
    },
    {
      "id": "ADR-0003",
      "title": "Advisory lock + atomic rename for concurrency",
      "status": "active",
      "context": "The app and several MCP processes may write the same file at once.",
      "decision": "Serialize writers with flock on a sidecar lock file and replace the file atomically; the app watches the path and reloads.",
      "rejected_alternatives": [
        {
          "option": "Last-writer-wins full document saves",
          "reason": "silently drops agent updates"
        },
        {
          "option": "A long-running daemon",
          "reason": "extra process to manage; MCP clients spawn servers on demand"
        }
      ],
      "related": [
        "atomic-writes",
        "file-watcher"
      ],
      "created_at": "2026-11-23T08:15:17Z",
      "updated_at": "2026-11-23T08:15:17Z"
    },
    {
      "id": "ADR-0004",
      "title": "SwiftPM build without Xcode",
      "status": "active",
      "context": "The build machine only has the Command Line Tools.",
      "decision": "Build the app with SwiftPM per architecture, lipo the slices, and assemble the bundle in build.sh.",
      "rejected_alternatives": [
        {
          "option": "Require Xcode",
          "reason": "not installed; contributors should not need it to build"
        }
      ],
      "related": [
        "engram-app"
      ],
      "created_at": "2026-11-23T12:50:12Z",
      "updated_at": "2026-11-23T12:50:12Z"
    }
  ],
